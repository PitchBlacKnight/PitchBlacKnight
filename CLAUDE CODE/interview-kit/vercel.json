{
  "cleanUrls": true,
  "redirects": [
    { "source": "/keystone", "destination": "/pathfinder/docs/", "permanent": false },
    { "source": "/keystone/docs", "destination": "/pathfinder/docs/", "permanent": false },
    { "source": "/pathfinder", "destination": "/pathfinder/docs/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
