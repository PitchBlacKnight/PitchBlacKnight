<script>
/* Highlight active section in the section nav */
(function() {
  const links = document.querySelectorAll('.section-nav a[data-section]');
  const sections = ['impact','problem','built','shipped','outcome'];

  function getActive() {
    const offset = 120;
    for (let i = sections.length - 1; i >= 0; i--) {
      const el = document.getElementById(sections[i]);
      if (el && el.getBoundingClientRect().top <= offset) return sections[i];
    }
    return sections[0];
  }

  function update() {
    const active = getActive();
    links.forEach(a => {
      a.classList.toggle('active', a.dataset.section === active);
    });
  }

  window.addEventListener('scroll', update, { passive: true });
  update();
})();
</script>
<script>
(function() {
  var btn = document.getElementById('themeToggle');
  if (btn) btn.addEventListener('click', function() {
    var isLight = document.documentElement.classList.toggle('light');
    localStorage.setItem('pbk-dark', isLight ? '0' : '1');
  });
})();
</script>
<script src="animations.js" defer></script>

