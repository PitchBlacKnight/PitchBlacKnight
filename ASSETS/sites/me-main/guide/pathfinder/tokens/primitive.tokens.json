      "3xl":  { "$type": "dimension", "$value": "24px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },

    "size": {
      "icon-xs":          { "$type": "dimension", "$value": "12px" },
      "icon-sm":          { "$type": "dimension", "$value": "16px" },
      "icon-md":          { "$type": "dimension", "$value": "20px" },
      "icon-lg":          { "$type": "dimension", "$value": "24px" },
      "icon-xl":          { "$type": "dimension", "$value": "32px" },
      "avatar-sm":        { "$type": "dimension", "$value": "32px" },
      "avatar-md":        { "$type": "dimension", "$value": "40px" },
      "avatar-lg":        { "$type": "dimension", "$value": "56px" },
      "avatar-xl":        { "$type": "dimension", "$value": "72px" },
      "button-sm":        { "$type": "dimension", "$value": "32px" },
      "button-md":        { "$type": "dimension", "$value": "40px" },
      "button-lg":        { "$type": "dimension", "$value": "48px" },
      "sidebar":          { "$type": "dimension", "$value": "64px" },
      "sidebar-expanded": { "$type": "dimension", "$value": "240px" },
      "topbar":           { "$type": "dimension", "$value": "56px" },
      "card-min":         { "$type": "dimension", "$value": "280px" },
      "target-min":       { "$type": "dimension", "$value": "44px", "$codeOnly": "WCAG 2.5.5 minimum target. No counterpart in PF3/Sizing — the smallest control there is 32px, so the target has to be reached with an invisible hit area rather than by inflating the control." }
    },

    "opacity": {
      "0":   { "$type": "number", "$value": 0 },
      "5":   { "$type": "number", "$value": 0.05 },
      "10":  { "$type": "number", "$value": 0.1 },
      "20":  { "$type": "number", "$value": 0.2 },
      "30":  { "$type": "number", "$value": 0.3 },
      "40":  { "$type": "number", "$value": 0.4 },
      "50":  { "$type": "number", "$value": 0.5 },
      "60":  { "$type": "number", "$value": 0.6 },
      "70":  { "$type": "number", "$value": 0.7 },
      "80":  { "$type": "number", "$value": 0.8 },
      "90":  { "$type": "number", "$value": 0.9 },
      "100": { "$type": "number", "$value": 1 }
    },

    "font": {
      "$description": "Families and weights only. There is deliberately no loose font-size scale — the ramp in typography.tokens.json is the public API for type, and it carries its own sizes because in Figma it lives as text styles rather than variables.",
      "family": {
        "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
        "mono": { "$type": "fontFamily", "$value": ["Roboto Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
      },
      "weight": {
        "regular":  { "$type": "number", "$value": 400 },
        "medium":   { "$type": "number", "$value": 500 },
        "semibold": { "$type": "number", "$value": 600 },
        "bold":     { "$type": "number", "$value": 700 }
      }
    },

    "duration": {
      "$description": "Motion is not tokenised in the Figma file — no collection, no scale. These exist so components can reference a token instead of a literal, and the build reports them as an un-mirrored gap.",
      "fast": { "$type": "duration", "$value": "120ms", "$codeOnly": "no counterpart in Figma" },
      "base": { "$type": "duration", "$value": "180ms", "$codeOnly": "no counterpart in Figma" },
      "slow": { "$type": "duration", "$value": "280ms", "$codeOnly": "no counterpart in Figma" }
    },

    "border": {
      "width": {
        "thin":  { "$type": "dimension", "$value": "1px", "$codeOnly": "stroke weights are set per-node in Figma, not bound to a variable" },
        "focus": { "$type": "dimension", "$value": "2px", "$codeOnly": "stroke weights are set per-node in Figma, not bound to a variable" }
      }
    }
