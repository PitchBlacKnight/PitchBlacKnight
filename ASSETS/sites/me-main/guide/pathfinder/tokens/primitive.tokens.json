    "space": {
      "$description": "Figma collection PF3/Spacing. The key is half the pixel value — space/8 is 16px. Kept verbatim: renaming the scale here would break every binding in the file.",
      "0":  { "$type": "dimension", "$value": "0px" },
      "1":  { "$type": "dimension", "$value": "2px" },
      "2":  { "$type": "dimension", "$value": "4px" },
      "3":  { "$type": "dimension", "$value": "6px" },
      "4":  { "$type": "dimension", "$value": "8px" },
      "5":  { "$type": "dimension", "$value": "10px" },
      "6":  { "$type": "dimension", "$value": "12px" },
      "8":  { "$type": "dimension", "$value": "16px" },
      "10": { "$type": "dimension", "$value": "20px" },
      "12": { "$type": "dimension", "$value": "24px" },
      "16": { "$type": "dimension", "$value": "32px" },
      "20": { "$type": "dimension", "$value": "40px" },
      "24": { "$type": "dimension", "$value": "48px" },
      "32": { "$type": "dimension", "$value": "64px" },
      "40": { "$type": "dimension", "$value": "80px" },
      "48": { "$type": "dimension", "$value": "96px" },
      "64": { "$type": "dimension", "$value": "128px" }
    },

    "radius": {
      "none": { "$type": "dimension", "$value": "0px" },
      "xs":   { "$type": "dimension", "$value": "2px" },
      "sm":   { "$type": "dimension", "$value": "4px" },
      "md":   { "$type": "dimension", "$value": "8px" },
      "lg":   { "$type": "dimension", "$value": "12px" },
      "xl":   { "$type": "dimension", "$value": "16px" },
