{
  "$description": "Tier 1 — PRIMITIVE. Raw, unopinionated values. Private: no component may reference this tier directly. Nothing here carries meaning; it is only a scale.",
  "primitive": {
    "color": {
      "neutral": {
        "0":    { "$type": "color", "$value": "#ffffff" },
        "50":   { "$type": "color", "$value": "#f7f6f3" },
        "100":  { "$type": "color", "$value": "#edebe6" },
        "200":  { "$type": "color", "$value": "#d9d5cc" },
        "300":  { "$type": "color", "$value": "#bfbab0" },
        "400":  { "$type": "color", "$value": "#9a938a" },
        "500":  { "$type": "color", "$value": "#7c756c" },
        "600":  { "$type": "color", "$value": "#5c564e" },
        "700":  { "$type": "color", "$value": "#403b35" },
        "800":  { "$type": "color", "$value": "#2a2724" },
        "900":  { "$type": "color", "$value": "#1a1917" },
        "1000": { "$type": "color", "$value": "#121110" }
      },
      "brand": {
        "100": { "$type": "color", "$value": "#fbe3d8" },
        "300": { "$type": "color", "$value": "#f2a882" },
        "500": { "$type": "color", "$value": "#e86a33" },
        "600": { "$type": "color", "$value": "#c8552b" },
        "700": { "$type": "color", "$value": "#9e4222" }
      },
      "danger":  { "500": { "$type": "color", "$value": "#c0392b" }, "600": { "$type": "color", "$value": "#9b2d22" } },
      "success": { "500": { "$type": "color", "$value": "#3f7d52" } },
      "warning": { "500": { "$type": "color", "$value": "#b7791f" } },
      "info":    { "500": { "$type": "color", "$value": "#2f6f9f" } }
    },

    "space": {
      "0": { "$type": "dimension", "$value": "0px" },
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "24px" },
      "6": { "$type": "dimension", "$value": "32px" },
      "7": { "$type": "dimension", "$value": "48px" },
      "8": { "$type": "dimension", "$value": "64px" }
    },

    "size": {
      "control": {
        "sm": { "$type": "dimension", "$value": "32px" },
        "md": { "$type": "dimension", "$value": "40px" },
        "lg": { "$type": "dimension", "$value": "48px" }
      },
      "target": { "min": { "$type": "dimension", "$value": "44px" } }
    },

    "radius": {
      "sm":   { "$type": "dimension", "$value": "4px" },
      "md":   { "$type": "dimension", "$value": "8px" },
      "lg":   { "$type": "dimension", "$value": "12px" },
      "full": { "$type": "dimension", "$value": "999px" }
    },

    "font": {
      "family": {
        "sans": { "$type": "fontFamily", "$value": ["Alexandria", "system-ui", "sans-serif"] },
        "mono": { "$type": "fontFamily", "$value": ["Space Mono", "ui-monospace", "monospace"] }
      },
      "size": {
        "xs":   { "$type": "dimension", "$value": "12px" },
        "sm":   { "$type": "dimension", "$value": "14px" },
        "base": { "$type": "dimension", "$value": "16px" },
        "lg":   { "$type": "dimension", "$value": "18px" },
        "xl":   { "$type": "dimension", "$value": "24px" }
      },
      "weight": {
        "regular": { "$type": "number", "$value": 400 },
        "medium":  { "$type": "number", "$value": 500 },
        "bold":    { "$type": "number", "$value": 700 }
      }
    },

    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "180ms" },
      "slow": { "$type": "duration", "$value": "280ms" }
    },

    "border": {
      "width": {
        "thin":  { "$type": "dimension", "$value": "1px" },
        "focus": { "$type": "dimension", "$value": "2px" }
      }
    }
  }
}
